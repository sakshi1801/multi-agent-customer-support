# Copy to .env and fill in. NEVER commit .env.
#
# Fill in at least ONE provider. If several are configured, LLM_PROVIDER picks one;
# otherwise the order is: Azure > Groq > OpenRouter > custom > OpenAI.
# The model must support tool calling.
# LLM_PROVIDER=groq            # azure | groq | openrouter | custom | openai

# --- Groq (free tier, no card: console.groq.com/keys) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (free with ":free" model IDs: openrouter.ai/keys) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Any other OpenAI-compatible server, e.g. local Ollama (free, runs on your PC) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=                 # leave empty for Ollama

# --- OpenAI (paid) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (paid; takes priority when AZURE_OPENAI_ENDPOINT is set) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- LangSmith tracing (optional, free Developer plan at smith.langchain.com) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=multi-agent-support
