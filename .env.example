# Copy to .env and fill in. NEVER commit .env.

# Fill in ONE option. Priority if several are set: Azure > OpenRouter > OpenAI.

# --- Option A: plain OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Option B: OpenRouter (one key, many models; key from openrouter.ai/keys) ---
# The model must support tool calling + structured output.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Option C: Azure OpenAI (takes priority if AZURE_OPENAI_ENDPOINT is set) ---
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- LangSmith tracing (optional, free tier at smith.langchain.com) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=multi-agent-support
